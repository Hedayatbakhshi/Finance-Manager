<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FinanceManager" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/expense</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialCardViewStyle">@style/Widget.Finance.Card</item>
        <item name="materialButtonStyle">@style/Widget.Finance.Button</item>
        <item name="textInputStyle">@style/Widget.Finance.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.Finance.BottomNav</item>
        <item name="balanceCardStart">@color/balance_card_start</item>
        <item name="balanceCardEnd">@color/balance_card_end</item>
        <item name="appGlow">@color/app_gradient_glow</item>
    </style>

    <style name="Theme.FinanceManager.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorOnPrimary">@color/dark_on_primary</item>
        <item name="colorPrimaryContainer">@color/dark_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/dark_on_primary_container</item>
        <item name="colorSecondary">@color/dark_primary</item>
        <item name="colorSecondaryContainer">@color/dark_primary_container</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/dark_text_secondary</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOutline">@color/dark_divider</item>
        <item name="colorOutlineVariant">@color/dark_divider</item>
        <item name="colorError">@color/expense</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurfaceContainer">@color/dark_surface</item>
        <item name="colorSurfaceContainerLow">@color/dark_surface</item>
        <item name="colorSurfaceContainerHigh">@color/dark_surface_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialCardViewStyle">@style/Widget.Finance.Card</item>
        <item name="materialButtonStyle">@style/Widget.Finance.Button</item>
        <item name="textInputStyle">@style/Widget.Finance.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.Finance.BottomNav</item>
    </style>

    <style name="Widget.Finance.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_floating_nav</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Finance.BottomNav.Indicator</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Finance.BottomNav</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Finance.BottomNav</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Finance.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="TextAppearance.Finance.BottomNav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.FinanceManager.Splash" parent="Theme.FinanceManager">
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.FinanceManager.Lock" parent="Theme.FinanceManager">
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- Selectable accent palettes, applied on top of the light base theme. -->
    <style name="ThemeOverlay.Finance.Accent.Blue" parent="">
        <item name="colorPrimary">#2E75D4</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DDEBFC</item>
        <item name="colorOnPrimaryContainer">#0B2A47</item>
        <item name="colorSecondary">#5A87C0</item>
        <item name="colorSecondaryContainer">#E7EFF9</item>
        <item name="balanceCardStart">#2E75D4</item>
        <item name="balanceCardEnd">#1D4E9E</item>
        <item name="appGlow">#1F5A87C0</item>
    </style>

    <style name="ThemeOverlay.Finance.Accent.Emerald" parent="">
        <item name="colorPrimary">#0F8A5F</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DDF3E9</item>
        <item name="colorOnPrimaryContainer">#063A28</item>
        <item name="colorSecondary">#0F8A5F</item>
        <item name="colorSecondaryContainer">#DDF3E9</item>
        <item name="balanceCardStart">#12946A</item>
        <item name="balanceCardEnd">#0A6247</item>
        <item name="appGlow">#1F16A36A</item>
    </style>

    <style name="ThemeOverlay.Finance.Accent.Violet" parent="">
        <item name="colorPrimary">#6C4BE0</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E9E3FC</item>
        <item name="colorOnPrimaryContainer">#241447</item>
        <item name="colorSecondary">#6C4BE0</item>
        <item name="colorSecondaryContainer">#E9E3FC</item>
        <item name="balanceCardStart">#7A5AF8</item>
        <item name="balanceCardEnd">#4B32B8</item>
        <item name="appGlow">#1F7A5AF8</item>
    </style>

    <style name="ThemeOverlay.Finance.Accent.Amber" parent="">
        <item name="colorPrimary">#B85F0E</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FCEBD9</item>
        <item name="colorOnPrimaryContainer">#3A1E05</item>
        <item name="colorSecondary">#B85F0E</item>
        <item name="colorSecondaryContainer">#FCEBD9</item>
        <item name="balanceCardStart">#D9761F</item>
        <item name="balanceCardEnd">#9C4A12</item>
        <item name="appGlow">#1FE07A2E</item>
    </style>

</resources>
